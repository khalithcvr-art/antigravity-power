{
  "cleanUrls": true,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/meydan-free-zone-license-cost",
      "destination": "/meydan-free-zone",
      "permanent": true
    },
    {
      "source": "/meydan-free-zone-license-cost/",
      "destination": "/meydan-free-zone",
      "permanent": true
    },
    {
      "source": "/business-setup-cost-abu-dhabi",
      "destination": "/mainland-business-setup",
      "permanent": true
    },
    {
      "source": "/business-setup-cost-abu-dhabi/",
      "destination": "/mainland-business-setup",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/#about",
      "permanent": true
    },
    {
      "source": "/about/",
      "destination": "/#about",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/services/",
      "destination": "/#services",
      "permanent": true
    }
  ]
}
